# Unity (https://github.com/github/gitignore/blob/main/Unity.gitignore)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

/[Mm]emoryCaptures/
/[Rr]ecordings/

# Crash / editor recovery (do not commit)
/[Aa]ssets/_[Rr]ecovery/

# Never ignore Asset meta data
!/[Aa]ssets/**/*.meta

# Exception: recovery folder meta must stay ignored (would be re-included by rule above)
/[Aa]ssets/_[Rr]ecovery.meta

# Uncomment this line if you wish to ignore the Asset Store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated JetBrains Rider plugin
[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio / Rider
.vs/
*.sln.iml

# Gradle (Android)
.gradle/

# Autogenerated solution & project files (Unity regenerates from External Tools)
# Comment these out if your workflow requires committing them (e.g. some CI setups).
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

ExportedObj/
.consulo/

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D crash report
sysinfo.txt

# Build artifacts
*.apk
*.aab
*.app
*.unitypackage
*.ipa

# Crashlytics
crashlytics-build.properties

# Addressables (generated binaries)
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.hash*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Plastic SCM
.plastic/
ignore.conf

# Asset audit outputs (regenerate: GeoWorld → Assets → Audit Unused Assets)
/audit-reports/unused-assets-*.csv
/audit-reports/unused-assets-*-summary.txt
/audit-reports/unity-audit.log
/audit-reports/unused-assets-grep-*.csv
/audit-reports/unused-assets-grep-*-summary.txt
Assets/_Quarantine/UnusedAssetAudit_*/

# OS junk
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
